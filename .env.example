# ---------------------------------------------------------------------------
# Classroom Tracker — environment variables
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (Render-hosted Postgres) --------------------------------------
# prisma/schema.prisma uses provider = "postgresql". Use the "External
# Database URL" Render shows on the Postgres instance's dashboard page (the
# "Internal Database URL" only resolves from inside Render's own network —
# use that one instead once this app is ALSO running as a Render Web Service,
# it's faster and doesn't leave Render's network).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME"

# Session JWT signing secret — REQUIRED (the app throws if missing; no fallback).
# Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="please-change-this-to-a-long-random-secret"

# Base URL of the app.
NEXTAUTH_URL="http://localhost:3000"

# Restrict sign-up and Google Sign-In student provisioning to one email
# domain (no "@"). Leave unset for local dev / a school not ready to commit
# to this yet — every account-creation path stays open otherwise. See
# TODO.md's security section and src/lib/allowed-email.ts.
# ALLOWED_EMAIL_DOMAIN="peddie.org"

# --- Google Sign-In (optional). Without these set, the "Continue with
# Google" button on /login still renders, but sends the user back with
# "Google Sign-In isn't set up yet." See TODO.md's "Google Sign-In setup"
# section for the exact Google Cloud Console steps to get these two values.
# These can ALSO be set from /admin/settings instead (stored encrypted in the
# DB, no redeploy needed) — that takes precedence over the env var here if
# both are set. Same two values are reserved for the still-unbuilt Google
# Sheets roster import (Milestone C.3), which can reuse this same OAuth client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

